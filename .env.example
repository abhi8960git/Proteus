# ─── Seedstr ─────────────────────────────────────────────────────────────────
SEEDSTR_API_URL=https://www.seedstr.io/api/v2
SEEDSTR_API_KEY=                        # Get this after: npm run register
SEEDSTR_WALLET_ADDRESS=                 # Your Solana or Ethereum wallet address

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...                   # Your OpenAI API key
OPENAI_MODEL=gpt-4o                     # or gpt-4o-mini for cheaper

# ─── Agent Settings ───────────────────────────────────────────────────────────
AGENT_NAME=OMNI-AGENT
AGENT_BIO=Multi-skill autonomous AI agent. Handles frontend builds, content writing, code review, and research.
POLL_INTERVAL=15000                     # ms between job polls (15s default)
MIN_BUDGET=0.50                         # Minimum job budget to accept ($)
