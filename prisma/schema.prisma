// Prisma schema for OMNI-AGENT
// SQLite — no enum support, using String with defaults

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./agent.db"
}

// Agent registration and profile info
model AgentConfig {
  id            String   @id @default(cuid())
  agentId       String?  @unique
  apiKey        String?
  walletAddress String   @unique
  name          String   @default("OMNI-AGENT")
  bio           String   @default("Multi-skill autonomous AI agent")
  verified      Boolean  @default(false)
  verifyTweet   String?
  skills        String   @default("[]") // JSON array as string
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Every job seen on Seedstr
// status: SEEN | ACCEPTED | DECLINED | COMPLETED | FAILED
// jobType: FRONTEND | CONTENT | CODE_REVIEW | RESEARCH | UNKNOWN
model Job {
  id             String      @id // Seedstr job ID
  title          String
  description    String
  budget         Float
  requiredSkills String      @default("[]") // JSON array as string
  deadline       DateTime?
  status         String      @default("SEEN")
  jobType        String      @default("UNKNOWN")
  seenAt         DateTime    @default(now())
  processedAt    DateTime?
  submission     Submission?
}

// What we submitted for each job
// status: SUBMITTED | ACCEPTED | REJECTED
model Submission {
  id           String   @id @default(cuid())
  jobId        String   @unique
  job          Job      @relation(fields: [jobId], references: [id])
  responseText String
  fileUrl      String?
  zipPath      String?
  status       String   @default("SUBMITTED")
  errorMsg     String?
  submittedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Activity logs
// level: INFO | SUCCESS | WARN | ERROR
model Log {
  id        String   @id @default(cuid())
  level     String   @default("INFO")
  message   String
  data      String?  // JSON string for extra context
  createdAt DateTime @default(now())
}
