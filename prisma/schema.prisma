generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./agent.db"
}

model AgentConfig {
  id            String   @id @default(cuid())
  agentId       String?  @unique
  apiKey        String?
  walletAddress String   @unique
  name          String   @default("OMNI-AGENT")
  bio           String   @default("Multi-skill autonomous AI agent")
  verified      Boolean  @default(false)
  verifyTweet   String?
  skills        String   @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Job {
  id             String      @id
  title          String
  description    String
  budget         Float
  requiredSkills String      @default("[]")
  deadline       DateTime?
  status         String      @default("SEEN")
  jobType        String      @default("UNKNOWN")
  seenAt         DateTime    @default(now())
  processedAt    DateTime?
  submission     Submission?
}

model Submission {
  id           String   @id @default(cuid())
  jobId        String   @unique
  responseText String
  fileUrl      String?
  zipPath      String?
  status       String   @default("SUBMITTED")
  errorMsg     String?
  submittedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt
  job          Job      @relation(fields: [jobId], references: [id])
}

model Log {
  id        String   @id @default(cuid())
  level     String   @default("INFO")
  message   String
  data      String?
  createdAt DateTime @default(now())
}
